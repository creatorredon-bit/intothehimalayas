# ---------------------------------------------------------------------------
# IntotheHimalayas — environment variables
# Copy to `.env` (never commit `.env`) and fill in your own values.
# ---------------------------------------------------------------------------

# Supabase project URL and *public* anon key.
# The anon key is safe to ship to the browser: every table is protected by RLS.
# The `service_role` key MUST NOT be exposed here. Use it only in server-side
# scripts (schema migration, seeding) and never prefix it with VITE_.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Public site origin, used for share links and Supabase redirect URLs.
VITE_SITE_URL=http://localhost:5173

# Map tiles — any OpenStreetMap-compatible raster provider.
# Defaults to OpenTopoMap (terrain) when these are omitted.
VITE_MAP_TILE_URL=https://{s}.tile.opentopomap.org/{z}/{x}/{y}.png
VITE_MAP_ATTRIBUTION=Map data &copy; OpenStreetMap contributors, SRTM | Map style &copy; OpenTopoMap (CC-BY-SA)
VITE_MAP_MAX_ZOOM=17
